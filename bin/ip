#!/bin/bash

# ============================================================
# ip - IPs do ambiente + acesso ao code-server
#
# Lista as instancias com IP publico nas regioes usadas pelo lab
# (via AWS CLI, sem terraform refresh) e mostra a URL do
# code-server da VM do fiaplab.
#
# Tambem atualiza as credenciais da VM (best-effort, sem prompt),
# igual ao boot do menu.
#
# Aceita um argumento opcional (projeto), ignorado -- e mantido
# so para compatibilidade com quem chama "ip <projeto>".
# ============================================================

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$BIN_DIR/.." && pwd)"

source "$BIN_DIR/fiaplab.lib.sh"

# ------------------------------------------------------------
# ATUALIZA OS DOIS REPOSITORIOS DO LAB
#
# O "./ip" e o comando que o aluno repete o tempo todo (pegar a
# URL do code-server), entao e o melhor lugar para manter os dois
# clones em dia: o config (playbooks, .tf, ajustar.sh) e este
# repo (bin/). Antes, o config so era atualizado pelo init.sh e o
# cloudshell so pelo lancador ~/ip -- quem roda "./ip" do bin/
# nao atualizava nenhum dos dois.
#
# Ordem importa:
#
#   1. config  -- nao e codigo em execucao, atualiza sem risco.
#   2. cloudshell -- este arquivo esta rodando; o bash le o script
#      em pedacos, e reescreve-lo no meio da execucao quebra o
#      resto. Entao, se o HEAD andou, re-executamos o comando ja
#      na versao nova (uma vez so, guardado por FIAPLAB_REEXEC).
#
# O lancador ~/ip (gerado pelo comandos.sh) ja atualiza o
# cloudshell antes do exec e avisa com FIAPLAB_REPO_PULLED=1,
# para nao pagarmos o pull duas vezes.
#
# Desative com FIAPLAB_NO_UPDATE=1.
# ------------------------------------------------------------

# FIAPLAB_REEXEC: ja viemos de um exec logo apos o pull, entao os
# dois repos acabaram de ser atualizados -- nao repete nem o aviso.
if [ -z "$FIAPLAB_NO_UPDATE" ] && [ -z "$FIAPLAB_REEXEC" ]; then

    echo ""
    echo ">> Atualizando repositórios do lab..."

    repo_pull "$CONFIG_DIR" "config"

    if [ -z "$FIAPLAB_REPO_PULLED" ]; then

        repo_pull "$REPO_DIR" "cloudshell"

        if [ "$?" -eq 10 ]; then
            export FIAPLAB_REEXEC=1
            exec "$BIN_DIR/ip" "$@"
        fi
    fi
fi

aws_require || exit 1

# ------------------------------------------------------------
# IPs de todas as instancias (2 regioes)
# ------------------------------------------------------------

echo ""
echo "IPs do ambiente:"
echo ""

for region in us-east-1 us-west-2; do
    aws ec2 describe-instances \
        --region "$region" \
        --query "Reservations[*].Instances[*].[PublicIpAddress, Tags[?Key=='Name'].Value|[0]]" \
        --output text |
        grep -v None |
        awk -F'\t' '{ printf "%-16s(%s)\n", $1, $2 }'
done

# ------------------------------------------------------------
# Acesso ao code-server (VM do fiaplab, em execucao)
# ------------------------------------------------------------

# Uma URL de code-server por VM em execução (badge e senha uma vez só).
mapfile -t VMS < <(fiaplab_running_name_ip)

if [ "${#VMS[@]}" -eq 0 ]; then
    echo ""
    echo "Acesso ao FIAP LAB (Code Server): nenhuma VM em execução."
    echo ""
    # Oferece ligar usando a MESMA funcao da opcao 1 do menu (vm_start).
    # Padrao SIM: so apertar ENTER ja liga.
    read -rp "Deseja ligar a(s) VM(s) agora? (S/n): " RESP_LIGAR
    if [[ ! "$RESP_LIGAR" =~ ^[Nn]$ ]] && aws_require; then
        echo ""
        echo "========================================"
        echo " LIGAR VM"
        echo "========================================"
        vm_start
        echo ""
        echo "Aguarde ~30s e rode  ./ip  novamente para ver as URLs."
    fi
elif [ "${#VMS[@]}" -eq 1 ]; then
    # 1 VM: mesmo formato de sempre (só a URL).
    codeserver_callout "${VMS[0]##*$'\t'}"
else
    echo ""
    echo "  ${C_BADGE} ABRA O FIAP LAB NO NAVEGADOR ${C_OFF}"
    echo "  ${C_DIM}copie e cole a URL da sua VM (o clique não abre no CloudShell):${C_OFF}"
    echo ""
    for VM in "${VMS[@]}"; do
        VM_NAME="${VM%%$'\t'*}"
        VM_IP="${VM##*$'\t'}"
        [ -n "$VM_IP" ] && [ "$VM_IP" != "None" ] || continue
        printf '      %-20s %shttp://%s:%s%s\n' \
            "$VM_NAME" "$C_URL" "$VM_IP" "$CODE_SERVER_PORT" "$C_OFF"
    done
    echo ""
    echo "      senha: ${C_BOLD}${CODE_SERVER_PASSWORD}${C_OFF}"
    echo ""
fi

# ------------------------------------------------------------
# Atualiza as credenciais da VM (best-effort, sem prompt).
# Só quando ha VM em execucao: VMs recem-ligadas acima ainda estao
# em "pending" (sem IP), e o aluno roda ./ip de novo quando subirem.
# ------------------------------------------------------------

if [ "${#VMS[@]}" -gt 0 ]; then
    echo ">> Atualizando credenciais da VM..."
    refresh_vm_credentials auto
fi
